void up(int u)
{
	while(u>1&&h[u/2]>h[u])
	{
		swap(h[u/2],h[u]);
		u /= 2;
	}
}

void down(int u)
{
	int t = u;
	if(u*2<=sz&&h[u*2]<h[u]) t = u*2;
	if(u*2+1<=sz&&h[u*2+1]<h[t]) t = u*2+1;
	if(t!=u)
	{
		swap(h[t],h[u]);
		down(t);
	}
