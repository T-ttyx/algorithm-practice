void solve()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	
	int n;
	cin>>n;
	
	int op,x;
	for(int i=0;i<n;i++)
	{
		cin>>op;
		if(op==1)
		{
			cin>>x;
			h[++sz] = x;
			up(sz);
		}else if(op==2) cout<<h[1]<<"\n";
		else 
		{
			h[1] = h[sz--];
			down(1);
		}
	}
}

int main()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	int T;
	//cin>>T;
	T = 1;
	while(T--)
	{
		solve();
	}
	
	return 0;
}

